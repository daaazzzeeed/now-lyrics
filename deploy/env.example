# /opt/lyrics-tv/.env  (chmod 600)
PORT=8787
# Длинная случайная строка: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ACCESS_KEY=CHANGE_ME

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Сдвиг текста вперёд, мс (компенсация задержки WiiM)
LYRICS_OFFSET_MS=250
# Пауза дольше этого — экран переходит в часы
IDLE_AFTER_S=180

# DATA_DIR задаёт systemd (/var/lib/lyrics-tv)
DEMO=0
